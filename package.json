{
  "name": "miracle-tree",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && npm run db:seed",
    "setup": "prisma generate && prisma db push && npm run db:seed",
    "test:e2e": "node scripts/reset-rate-limits.mjs && playwright test",
    "test:e2e:ui": "node scripts/reset-rate-limits.mjs && playwright test --ui",
    "shots": "node scripts/reset-rate-limits.mjs && playwright test e2e/shots.spec.ts --project=desktop",
    "sweep": "node scripts/sweep-reservations.mjs",
    "db:postgres": "node scripts/use-postgres.mjs postgresql",
    "db:sqlite": "node scripts/use-postgres.mjs sqlite"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "gsap": "^3.12.7",
    "jose": "^6.0.10",
    "lenis": "^1.2.3",
    "lucide-react": "^0.485.0",
    "nanoid": "^5.1.5",
    "next": "^15.2.4",
    "razorpay": "^2.9.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.1",
    "sharp": "^0.34.1",
    "tailwind-merge": "^3.0.2",
    "three": "^0.175.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.0.17",
    "@types/node": "^22.13.14",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.175.0",
    "prisma": "^6.5.0",
    "tailwindcss": "^4.0.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
