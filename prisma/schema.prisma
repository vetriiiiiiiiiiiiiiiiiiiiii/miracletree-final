// Miracle Tree — commerce data model.
// Portable by design: no native enums, no scalar lists. To move to Postgres in
// production, change `provider` to "postgresql" and point DATABASE_URL at it.
// Status/role fields are strings validated by the unions in src/lib/constants.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- identity

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String
  firstName      String?
  lastName       String?
  phone          String?
  role           String    @default("customer") // customer | staff | admin
  emailVerified  Boolean   @default(false)
  marketingOptIn Boolean   @default(false)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  addresses     Address[]
  orders        Order[]
  reviews       Review[]
  wishlistItems WishlistItem[]
  carts         Cart[]
  resetTokens   PasswordResetToken[]
  auditLogs     AuditLog[]
  notes         CustomerNote[]

  @@index([role])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  label      String?
  firstName  String
  lastName   String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String   @default("India")
  phone      String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
}

model CustomerNote {
  id        String   @id @default(cuid())
  userId    String
  body      String
  authorId  String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------- catalogue

model Category {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  description    String?
  imageUrl       String?
  parentId       String?
  position       Int      @default(0)
  isActive       Boolean  @default(true)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
}

model Collection {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  isActive    Boolean  @default(true)
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products ProductCollection[]
}

model ProductCollection {
  productId    String
  collectionId String
  position     Int    @default(0)

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
}

model Product {
  id               String  @id @default(cuid())
  name             String
  slug             String  @unique
  sku              String?
  productType      String?
  categoryId       String?
  shortDescription String?
  description      String?
  story            String?

  // Money is stored in paise (integer) to avoid floating point drift.
  price          Int
  compareAtPrice Int?
  taxRatePct     Int  @default(0)

  weightGrams Int?
  dimensions  String?

  status       String  @default("draft") // draft | published | archived
  isFeatured   Boolean @default(false)
  isNew        Boolean @default(false)
  isBestSeller Boolean @default(false)
  isOnSale     Boolean @default(false)

  model3dUrl String?
  videoUrl   String?

  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  ogImageUrl     String?

  position    Int       @default(0)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  category      Category?           @relation(fields: [categoryId], references: [id])
  variants      ProductVariant[]
  images        ProductImage[]
  ingredients   ProductIngredient[]
  benefits      ProductBenefit[]
  usageSteps    UsageStep[]
  faqs          Faq[]
  reviews       Review[]
  collections   ProductCollection[]
  tags          ProductTag[]
  orderItems    OrderItem[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]

  relatedFrom ProductRelation[] @relation("RelationSource")
  relatedTo   ProductRelation[] @relation("RelationTarget")

  @@index([status])
  @@index([categoryId])
  @@index([isFeatured])
}

model ProductRelation {
  id       String @id @default(cuid())
  sourceId String
  targetId String
  kind     String @default("related") // related | crosssell | upsell
  position Int    @default(0)

  source Product @relation("RelationSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target Product @relation("RelationTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, kind])
}

model Tag {
  id       String       @id @default(cuid())
  name     String       @unique
  slug     String       @unique
  products ProductTag[]
}

model ProductTag {
  productId String
  tagId     String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
}

model ProductVariant {
  id             String   @id @default(cuid())
  productId      String
  name           String
  // Unique because a stock-keeping unit that names two products keeps no
  // stock. Nullable, so variants without a code are simply absent from the
  // index rather than colliding on the empty string.
  sku            String?  @unique
  price          Int
  compareAtPrice Int?
  weightGrams    Int?
  imageUrl       String?
  position       Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory  Inventory?
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  width     Int?
  height    Int?
  position  Int     @default(0)
  kind      String  @default("gallery")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Ingredient {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?
  imageUrl    String?
  origin      String?

  products ProductIngredient[]
}

model ProductIngredient {
  productId    String
  ingredientId String
  amount       String?
  position     Int     @default(0)

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([productId, ingredientId])
}

model ProductBenefit {
  id        String  @id @default(cuid())
  productId String
  title     String
  body      String?
  icon      String?
  position  Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model UsageStep {
  id        String  @id @default(cuid())
  productId String
  step      Int
  title     String
  body      String?
  imageUrl  String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ---------------------------------------------------------------- inventory

model Inventory {
  id             String   @id @default(cuid())
  variantId      String   @unique
  onHand         Int      @default(0)
  reserved       Int      @default(0)
  lowStockAt     Int      @default(10)
  trackInventory Boolean  @default(true)
  updatedAt      DateTime @updatedAt

  variant   ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  movements InventoryMovement[]
}

model InventoryMovement {
  id          String   @id @default(cuid())
  inventoryId String
  delta       Int
  reason      String
  reference   String?
  actorId     String?
  createdAt   DateTime @default(now())

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId])
}

// ---------------------------------------------------------------- cart

model Cart {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String?
  couponId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  coupon Coupon?    @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items  CartItem[]

  @@index([userId])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  variantId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([cartId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

// ---------------------------------------------------------------- orders

model Order {
  id          String  @id @default(cuid())
  orderNumber String  @unique
  userId      String?
  email       String
  phone       String?

  status            String @default("pending")
  paymentStatus     String @default("unpaid")
  fulfillmentStatus String @default("unfulfilled")

  subtotal      Int
  discountTotal Int @default(0)
  shippingTotal Int @default(0)
  taxTotal      Int @default(0)
  grandTotal    Int

  couponCode String?
  addressId  String?

  shippingName       String
  shippingLine1      String
  shippingLine2      String?
  shippingCity       String
  shippingState      String
  shippingPostalCode String
  shippingCountry    String  @default("India")
  shippingPhone      String

  paymentProvider String?
  paymentRef      String?
  paymentOrderId  String?
  trackingNumber  String?
  trackingUrl     String?
  notes           String?

  placedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  address Address?     @relation(fields: [addressId], references: [id], onDelete: SetNull)
  items   OrderItem[]
  events  OrderEvent[]

  @@index([userId])
  @@index([status])
  @@index([placedAt])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String?
  variantId   String?
  productName String
  variantName String
  sku         String?
  imageUrl    String?
  unitPrice   Int
  quantity    Int
  lineTotal   Int

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  status    String
  message   String?
  actorId   String?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ---------------------------------------------------------------- promotions

model Coupon {
  id           String    @id @default(cuid())
  code         String    @unique
  description  String?
  kind         String    @default("percentage") // percentage | fixed | free_shipping
  value        Int       @default(0)
  minSubtotal  Int       @default(0)
  maxDiscount  Int?
  appliesTo    String    @default("all") // all | product | category | first_order
  appliesToIds String?
  usageLimit   Int?
  usageCount   Int       @default(0)
  perUserLimit Int?
  startsAt     DateTime?
  endsAt       DateTime?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  carts Cart[]
}

// ---------------------------------------------------------------- content

model Review {
  id          String   @id @default(cuid())
  productId   String
  userId      String?
  authorName  String
  authorEmail String?
  rating      Int
  title       String?
  body        String
  status      String   @default("pending") // pending | approved | rejected
  isVerified  Boolean  @default(false)
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([status])
}

model Testimonial {
  id         String   @id @default(cuid())
  authorName String
  location   String?
  body       String
  rating     Int      @default(5)
  imageUrl   String?
  isActive   Boolean  @default(true)
  position   Int      @default(0)
  createdAt  DateTime @default(now())
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String   @default("general")
  productId String?
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([category])
}

model ArticleCategory {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  articles Article[]
}

model Article {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  excerpt        String?
  content        String
  heroImageUrl   String?
  authorName     String    @default("Miracle Tree")
  categoryId     String?
  tags           String?
  readingMinutes Int       @default(4)
  status         String    @default("draft")
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  category ArticleCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([status])
}

model HomepageSection {
  id        String   @id @default(cuid())
  key       String   @unique
  kind      String
  title     String?
  subtitle  String?
  body      String?
  ctaLabel  String?
  ctaHref   String?
  mediaUrl  String?
  data      String?
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model NavigationItem {
  id       String  @id @default(cuid())
  label    String
  href     String
  group    String  @default("header")
  parentId String?
  position Int     @default(0)
  isActive Boolean @default(true)

  parent   NavigationItem?  @relation("NavTree", fields: [parentId], references: [id])
  children NavigationItem[] @relation("NavTree")
}

model Announcement {
  id       String    @id @default(cuid())
  message  String
  href     String?
  isActive Boolean   @default(true)
  startsAt DateTime?
  endsAt   DateTime?
  position Int       @default(0)
}

model Media {
  id        String   @id @default(cuid())
  url       String
  kind      String   @default("image")
  alt       String?
  width     Int?
  height    Int?
  sizeBytes Int?
  mimeType  String?
  folder    String?
  createdAt DateTime @default(now())
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  meta      String?
  ip        String?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity])
  @@index([createdAt])
}

model RateLimit {
  id        String   @id
  count     Int      @default(0)
  expiresAt DateTime
}

// ---------------------------------------------------------------- our story

/**
 * A dated entry on the company timeline. Kept as rows rather than markup so the
 * business can add to its own history without a deploy.
 */
model Milestone {
  id        String   @id @default(cuid())
  year      String
  title     String
  body      String?
  /**
   * Where the claim comes from, shown as a citation.
   */
  source    String?
  sourceUrl String?
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
}

/**
 * Awards, certifications and recognitions.
 * `sourceUrl` is deliberately part of the model: an unverifiable certification
 * claim on a food brand is a legal problem, so every entry can carry the place
 * it was published.
 */
model Accolade {
  id        String   @id @default(cuid())
  kind      String   @default("award") // award | certification | recognition
  title     String
  issuer    String?
  year      String?
  body      String?
  source    String?
  sourceUrl String?
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind])
}

/**
 * A named person or partner shown in the credits.
 */
model Credit {
  id        String   @id @default(cuid())
  name      String
  role      String
  body      String?
  imageUrl  String?
  /// Where to find them — a partner's site, or the source of a borrowed idea.
  url       String?
  group     String   @default("team") // team | partner | grower
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([group])
}

// ------------------------------------------------------------- leadership

/**
 * A named leader with a full profile of their own.
 *
 * Distinct from `Credit`, which is a one-line acknowledgement in a list. A
 * Leader carries a portrait, a long biography and its own dated highlights,
 * because the founders' record — patents, advisory work, state awards — is a
 * substantial part of why a buyer trusts a food brand, and a single line of
 * credit cannot hold it.
 *
 * `isFounder` promotes one row to the featured profile at the top of
 * /leadership; the rest render as the team below.
 */
model Leader {
  id         String  @id @default(cuid())
  name       String
  role       String
  /// A short qualifier under the name — "Engineer-agriculturist", "MS, Ophthalmology".
  credential String?
  /// One or two sentences, used on cards and in the grid.
  bio        String?
  /// The full profile. Blank lines separate paragraphs.
  longBio    String?
  /// Something they said, shown as a pull quote on the profile.
  quote      String?
  imageUrl   String?
  /// Where their record is published, shown as a citation.
  source     String?
  sourceUrl  String?
  isFounder  Boolean @default(false)
  position   Int     @default(0)
  isActive   Boolean @default(true)

  highlights LeaderHighlight[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isFounder])
  @@index([isActive])
}

/**
 * One dated entry on a leader's record: an award, a patent, a posting.
 * A relation rather than a scalar list, so the model stays portable to
 * Postgres unchanged.
 */
model LeaderHighlight {
  id       String  @id @default(cuid())
  leaderId String
  leader   Leader  @relation(fields: [leaderId], references: [id], onDelete: Cascade)
  /// "2022–23", or blank for an undated standing fact.
  year     String?
  title    String
  body     String?
  /// award | patent | role | recognition — drives the icon shown beside it.
  kind     String  @default("recognition")
  position Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leaderId])
}
