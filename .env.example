# --- Core -------------------------------------------------------------
DATABASE_URL="file:./dev.db"
AUTH_SECRET="generate-with-openssl-rand-base64-48"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Seeded admin account (change the password after first login) ------
SEED_ADMIN_EMAIL="admin@miracletree.in"
SEED_ADMIN_PASSWORD="ChangeMe!2026"

# --- Payments (Razorpay). Leave blank to run checkout in COD-only mode -
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# --- Analytics (optional) ---------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
GOOGLE_SITE_VERIFICATION=""

# --- Stock reservations -----------------------------------------------
# How long an unpaid order may hold its stock before the sweep releases it.
# Generous on purpose: a shopper who opens the gateway, goes to fetch a card
# and comes back must still find their basket intact. See DEPLOYMENT.md.
RESERVATION_TTL_MINUTES="45"
